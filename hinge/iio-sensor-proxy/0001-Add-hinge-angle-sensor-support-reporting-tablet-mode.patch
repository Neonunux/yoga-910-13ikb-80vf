diff --git a/src/test-hinge.c b/src/test-hinge.c
new file mode 100644
index 0000000..3bc223b
--- /dev/null
+++ b/src/test-hinge.c
@@ -0,0 +1,177 @@
+/*
+ * Copyright (c) 2026 Régis LELOUP <neonunux@gmail.com>
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 3 as published by
+ * the Free Software Foundation.
+ */
+
+#include <glib.h>
+#include <locale.h>
+#include "hinge.h"
+
+static HingeMode
+feed (HingeState    *state,
+      const gdouble *angles,
+      gsize          n_angles,
+      LidState       lid)
+{
+	gsize i;
+
+	for (i = 0; i < n_angles; i++)
+		hinge_state_update (state, angles[i], lid);
+	return state->mode;
+}
+
+static void
+test_hinge_startup (void)
+{
+	static const struct {
+		gdouble   angle;
+		LidState  lid;
+		HingeMode expected;
+	} tests[] = {
+		{ 110.0, LID_STATE_UNKNOWN, HINGE_MODE_LAPTOP },
+		{ 300.0, LID_STATE_UNKNOWN, HINGE_MODE_TABLET },
+		{ 185.0, LID_STATE_UNKNOWN, HINGE_MODE_LAPTOP },	/* laptop opened flat */
+		{   5.0, LID_STATE_OPEN,    HINGE_MODE_TABLET },	/* folded flat */
+		{   5.0, LID_STATE_CLOSED,  HINGE_MODE_LAPTOP },	/* closed lid */
+		{   5.0, LID_STATE_UNKNOWN, HINGE_MODE_UNDEFINED },
+	};
+	guint i;
+
+	for (i = 0; i < G_N_ELEMENTS (tests); i++) {
+		HingeState state;
+
+		hinge_state_init (&state);
+		hinge_state_update (&state, tests[i].angle, tests[i].lid);
+		g_assert_cmpint (state.mode, ==, tests[i].expected);
+	}
+}
+
+static void
+test_hinge_debounce (void)
+{
+	HingeState state;
+
+	hinge_state_init (&state);
+	g_assert_true (hinge_state_update (&state, 110.0, LID_STATE_UNKNOWN));
+
+	/* A single reading is not enough to change modes */
+	g_assert_false (hinge_state_update (&state, 250.0, LID_STATE_UNKNOWN));
+	g_assert_cmpint (state.mode, ==, HINGE_MODE_LAPTOP);
+	g_assert_false (hinge_state_update (&state, 110.0, LID_STATE_UNKNOWN));
+	g_assert_false (hinge_state_update (&state, 250.0, LID_STATE_UNKNOWN));
+	g_assert_cmpint (state.mode, ==, HINGE_MODE_LAPTOP);
+
+	/* Two in a row are */
+	g_assert_true (hinge_state_update (&state, 260.0, LID_STATE_UNKNOWN));
+	g_assert_cmpint (state.mode, ==, HINGE_MODE_TABLET);
+}
+
+static void
+test_hinge_hysteresis (void)
+{
+	static const gdouble to_tablet[] = { 300.0, 300.0 };
+	static const gdouble dead_band[] = { 185.0, 185.0, 175.0, 199.0 };
+	static const gdouble to_laptop[] = { 160.0, 160.0 };
+	HingeState state;
+
+	hinge_state_init (&state);
+	g_assert_cmpint (feed (&state, to_tablet, G_N_ELEMENTS (to_tablet), LID_STATE_UNKNOWN), ==, HINGE_MODE_TABLET);
+	g_assert_cmpint (feed (&state, dead_band, G_N_ELEMENTS (dead_band), LID_STATE_UNKNOWN), ==, HINGE_MODE_TABLET);
+	g_assert_cmpint (feed (&state, to_laptop, G_N_ELEMENTS (to_laptop), LID_STATE_UNKNOWN), ==, HINGE_MODE_LAPTOP);
+	g_assert_cmpint (feed (&state, dead_band, G_N_ELEMENTS (dead_band), LID_STATE_UNKNOWN), ==, HINGE_MODE_LAPTOP);
+}
+
+static void
+test_hinge_folded (void)
+{
+	static const gdouble fold[] = { 300.0, 350.0, 2.0, 0.0, 5.0, 0.0 };
+	static const gdouble open_lid[] = { 3.0, 10.0, 25.0, 20.0 };
+	HingeState state;
+
+	/* Folded flat: the angle wraps around to 0, stay in tablet mode,
+	 * whatever the lid switch says once started */
+	hinge_state_init (&state);
+	g_assert_cmpint (feed (&state, fold, G_N_ELEMENTS (fold), LID_STATE_UNKNOWN), ==, HINGE_MODE_TABLET);
+	g_assert_cmpint (feed (&state, fold + 2, 4, LID_STATE_CLOSED), ==, HINGE_MODE_TABLET);
+
+	/* Opening a closed lid goes through small angles with the lid
+	 * switch already open: stay in laptop mode */
+	hinge_state_init (&state);
+	g_assert_true (hinge_state_update (&state, 1.0, LID_STATE_CLOSED));
+	g_assert_cmpint (feed (&state, open_lid, G_N_ELEMENTS (open_lid), LID_STATE_OPEN), ==, HINGE_MODE_LAPTOP);
+}
+
+static void
+test_hinge_fast_fold (void)
+{
+	static const gdouble slow_close[] = { 110.0, 60.0, 20.0, 0.0 };
+	HingeState state;
+
+	/* Folded so fast that a single reading was seen in the tablet range */
+	hinge_state_init (&state);
+	g_assert_true (hinge_state_update (&state, 119.0, LID_STATE_UNKNOWN));
+	g_assert_false (hinge_state_update (&state, 280.0, LID_STATE_UNKNOWN));
+	g_assert_cmpint (state.mode, ==, HINGE_MODE_LAPTOP);
+	g_assert_true (hinge_state_update (&state, 0.0, LID_STATE_UNKNOWN));
+	g_assert_cmpint (state.mode, ==, HINGE_MODE_TABLET);
+	g_assert_false (hinge_state_update (&state, 3.0, LID_STATE_UNKNOWN));
+	g_assert_cmpint (state.mode, ==, HINGE_MODE_TABLET);
+
+	/* Closing the lid, slowly or not, stays in laptop mode */
+	hinge_state_init (&state);
+	g_assert_cmpint (feed (&state, slow_close, G_N_ELEMENTS (slow_close), LID_STATE_OPEN), ==, HINGE_MODE_LAPTOP);
+	hinge_state_init (&state);
+	g_assert_true (hinge_state_update (&state, 110.0, LID_STATE_UNKNOWN));
+	g_assert_false (hinge_state_update (&state, 0.0, LID_STATE_OPEN));
+	g_assert_cmpint (state.mode, ==, HINGE_MODE_LAPTOP);
+}
+
+/* Hinge angles recorded on a Lenovo Yoga 910-13IKB, folded into a tablet
+ * and back, one reading every quarter of a second */
+static void
+test_hinge_recorded (void)
+{
+	static const gdouble angles[] = {
+		112, 133, 157, 198, 267, 303, 317, 328, 341, 2, 7, 0, 6, 0, 5,
+		0, 351, 319, 298, 263, 241, 207, 194, 89, 96, 89
+	};
+	static const HingeMode expected[] = {
+		HINGE_MODE_LAPTOP, HINGE_MODE_LAPTOP, HINGE_MODE_LAPTOP,
+		HINGE_MODE_LAPTOP, HINGE_MODE_LAPTOP, HINGE_MODE_TABLET,
+		HINGE_MODE_TABLET, HINGE_MODE_TABLET, HINGE_MODE_TABLET,
+		HINGE_MODE_TABLET, HINGE_MODE_TABLET, HINGE_MODE_TABLET,
+		HINGE_MODE_TABLET, HINGE_MODE_TABLET, HINGE_MODE_TABLET,
+		HINGE_MODE_TABLET, HINGE_MODE_TABLET, HINGE_MODE_TABLET,
+		HINGE_MODE_TABLET, HINGE_MODE_TABLET, HINGE_MODE_TABLET,
+		HINGE_MODE_TABLET, HINGE_MODE_TABLET, HINGE_MODE_TABLET,
+		HINGE_MODE_LAPTOP, HINGE_MODE_LAPTOP
+	};
+	HingeState state;
+	guint i;
+
+	G_STATIC_ASSERT (G_N_ELEMENTS (angles) == G_N_ELEMENTS (expected));
+
+	hinge_state_init (&state);
+	for (i = 0; i < G_N_ELEMENTS (angles); i++) {
+		hinge_state_update (&state, angles[i], LID_STATE_OPEN);
+		g_assert_cmpint (state.mode, ==, expected[i]);
+	}
+}
+
+int main (int argc, char **argv)
+{
+	setlocale (LC_ALL, "");
+	g_test_init (&argc, &argv, NULL);
+
+	g_test_add_func ("/iio-sensor-proxy/hinge/startup", test_hinge_startup);
+	g_test_add_func ("/iio-sensor-proxy/hinge/debounce", test_hinge_debounce);
+	g_test_add_func ("/iio-sensor-proxy/hinge/hysteresis", test_hinge_hysteresis);
+	g_test_add_func ("/iio-sensor-proxy/hinge/folded", test_hinge_folded);
+	g_test_add_func ("/iio-sensor-proxy/hinge/fast-fold", test_hinge_fast_fold);
+	g_test_add_func ("/iio-sensor-proxy/hinge/recorded", test_hinge_recorded);
+
+	return g_test_run ();
+}
