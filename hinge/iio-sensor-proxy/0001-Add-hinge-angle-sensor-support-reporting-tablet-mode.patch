 }
 
+static void
+hinge_changed_func (SensorDevice *sensor_device,
+		    gpointer      readings_data,
+		    gpointer      user_data)
+{
+	SensorData *data = user_data;
+	HingeReadings *readings = (HingeReadings *) readings_data;
+	LidState lid = LID_STATE_UNKNOWN;
+
+	/* The lid switch only matters to tell a closed lid from a tablet
+	 * folded flat on the first reading */
+	if (data->hinge_state.mode == HINGE_MODE_UNDEFINED &&
+	    hinge_angle_is_folded (readings->angle))
+		lid = tablet_mode_get_lid_state (data->client);
+
+	if (!hinge_state_update (&data->hinge_state, readings->angle, lid))
+		return;
+
+	g_message ("Hinge at %.0f degrees, reporting %s mode",
+		   readings->angle, hinge_mode_to_string (data->hinge_state.mode));
+
+	if (data->tablet_mode_switch == NULL)
+		data->tablet_mode_switch = tablet_mode_switch_new ();
+	if (data->tablet_mode_switch != NULL)
+		tablet_mode_switch_set (data->tablet_mode_switch,
+					data->hinge_state.mode == HINGE_MODE_TABLET);
+}
+
+/* Unlike other sensors, the hinge is not claimed by clients: it drives the
+ * tablet mode switch for as long as it is present, unless a kernel driver
+ * already reports tablet mode. */
+static void
+hinge_start (SensorData *data)
+{
+	SensorDevice *sensor_device = DEVICE_FOR_TYPE(DRIVER_TYPE_HINGE);
+
+	if (tablet_mode_native_switch_exists (data->client)) {
+		g_message ("Tablet mode is already reported by the kernel, not using %s",
+			   sensor_device->name);
+		return;
+	}
+
+	g_message ("Reporting tablet mode from %s", sensor_device->name);
+	hinge_state_init (&data->hinge_state);
+	driver_set_polling (sensor_device, TRUE);
+
+	/* Some sensor hubs derive the hinge angle from their accelerometers, and
+	 * only update it while the display accelerometer is enabled, like the
+	 * ITE hub of Lenovo Yoga convertibles: keep it running along. */
+	data->hinge_active = TRUE;
+	if (driver_type_exists (data, DRIVER_TYPE_ACCEL))
+		driver_set_polling (DEVICE_FOR_TYPE(DRIVER_TYPE_ACCEL), TRUE);
+}
+
+static void
+hinge_stop (SensorData *data)
+{
+	g_clear_pointer (&data->tablet_mode_switch, tablet_mode_switch_free);
+	hinge_state_init (&data->hinge_state);
+
+	if (data->hinge_active &&
+	    driver_type_exists (data, DRIVER_TYPE_ACCEL) &&
+	    g_hash_table_size (data->clients[DRIVER_TYPE_ACCEL]) == 0)
+		driver_set_polling (DEVICE_FOR_TYPE(DRIVER_TYPE_ACCEL), FALSE);
+	data->hinge_active = FALSE;
+}
+
 static ReadingsUpdateFunc
 driver_type_to_callback_func (DriverType type)
 {
@@ -987,6 +1079,8 @@ driver_type_to_callback_func (DriverType type)
 		return compass_changed_func;
 	case DRIVER_TYPE_PROXIMITY:
 		return proximity_changed_func;
+	case DRIVER_TYPE_HINGE:
+		return hinge_changed_func;
 	default:
 		g_assert_not_reached ();
 	}
@@ -1013,6 +1107,7 @@ free_sensor_data (SensorData *data)
 		g_clear_pointer (&data->sensor_startup_dbus_invocations_delayed[i], g_ptr_array_unref);
 	}
 
+	g_clear_pointer (&data->tablet_mode_switch, tablet_mode_switch_free);
 	g_clear_object (&data->auth);
 	g_clear_pointer (&data->introspection_data, g_dbus_node_info_unref);
 	g_clear_object (&data->connection);
@@ -1049,6 +1144,9 @@ sensor_changes (GUdevClient *client,
 				DEVICE_FOR_TYPE(i) = NULL;
 				DRIVER_FOR_TYPE(i) = NULL;
 
+				if (i == DRIVER_TYPE_HINGE)
+					hinge_stop (data);
+
 				g_clear_pointer (&data->clients[i], g_hash_table_unref);
 				data->clients[i] = create_clients_hash_table ();
 
@@ -1103,7 +1201,9 @@ sensor_changes (GUdevClient *client,
 
 					ht = data->clients[driver->type];
 
-					if (g_hash_table_size (ht) > 0) {
+					if (driver->type == DRIVER_TYPE_HINGE) {
+						hinge_start (data);
+					} else if (g_hash_table_size (ht) > 0) {
 						SensorDevice *sensor_device = DEVICE_FOR_TYPE(driver->type);
 
 						/* Sensor just appeared but it's already claimed by some clients. Wait
@@ -1115,6 +1215,9 @@ sensor_changes (GUdevClient *client,
 					} else {
 						send_driver_changed_dbus_event (data, driver->type);
 					}
+
+					if (driver->type == DRIVER_TYPE_ACCEL && data->hinge_active)
+						driver_set_polling (sensor_device, TRUE);
 				}
 				break;
 			}
