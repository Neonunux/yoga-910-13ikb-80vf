diff --git a/src/tablet-mode.c b/src/tablet-mode.c
new file mode 100644
index 0000000..279b140
--- /dev/null
+++ b/src/tablet-mode.c
@@ -0,0 +1,170 @@
+/*
+ * Copyright (c) 2026 Régis LELOUP <neonunux@gmail.com>
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 3 as published by
+ * the Free Software Foundation.
+ */
+
+#include "tablet-mode.h"
+
+#include <glib/gstdio.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <linux/input.h>
+#include <linux/uinput.h>
+
+#define SWITCH_NAME "iio-sensor-proxy tablet mode switch"
+
+struct TabletModeSwitch {
+	int fd;
+};
+
+/* The "capabilities/sw" attribute of input devices is a hexadecimal bitmask */
+static gboolean
+input_device_has_switch (GUdevDevice *device,
+			 guint        code)
+{
+	const char *caps;
+	guint64 bits;
+
+	caps = g_udev_device_get_sysfs_attr (device, "capabilities/sw");
+	if (caps == NULL)
+		return FALSE;
+	bits = g_ascii_strtoull (caps, NULL, 16);
+	return (bits >> code) & 1;
+}
+
+static gboolean
+input_device_is_ours (GUdevDevice *device)
+{
+	return g_strcmp0 (g_udev_device_get_sysfs_attr (device, "name"), SWITCH_NAME) == 0;
+}
+
+gboolean
+tablet_mode_native_switch_exists (GUdevClient *client)
+{
+	g_autolist(GUdevDevice) devices = NULL;
+	GList *l;
+
+	devices = g_udev_client_query_by_subsystem (client, "input");
+	for (l = devices; l != NULL; l = l->next) {
+		GUdevDevice *dev = l->data;
+
+		if (!g_str_has_prefix (g_udev_device_get_name (dev), "input"))
+			continue;
+		if (input_device_has_switch (dev, SW_TABLET_MODE) &&
+		    !input_device_is_ours (dev)) {
+			g_debug ("Found native tablet mode switch '%s' at %s",
+				 g_udev_device_get_sysfs_attr (dev, "name"),
+				 g_udev_device_get_sysfs_path (dev));
+			return TRUE;
+		}
+	}
+	return FALSE;
+}
+
+static LidState
+read_lid_state (const char *device_file)
+{
+	guint8 bits[SW_MAX / 8 + 1] = { 0 };
+	g_autofd int fd = -1;
+
+	fd = open (device_file, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0) {
+		g_debug ("Could not open lid switch %s: %s", device_file, g_strerror (errno));
+		return LID_STATE_UNKNOWN;
+	}
+	if (ioctl (fd, EVIOCGSW (sizeof (bits)), bits) < 0) {
+		g_debug ("Could not read lid switch %s: %s", device_file, g_strerror (errno));
+		return LID_STATE_UNKNOWN;
+	}
+	return (bits[SW_LID / 8] & (1 << (SW_LID % 8))) ? LID_STATE_CLOSED : LID_STATE_OPEN;
+}
+
+LidState
+tablet_mode_get_lid_state (GUdevClient *client)
+{
+	g_autolist(GUdevDevice) devices = NULL;
+	GList *l;
+
+	devices = g_udev_client_query_by_subsystem (client, "input");
+	for (l = devices; l != NULL; l = l->next) {
+		GUdevDevice *dev = l->data;
+		g_autoptr(GUdevDevice) parent = NULL;
+		const char *device_file;
+
+		if (!g_str_has_prefix (g_udev_device_get_name (dev), "event"))
+			continue;
+		device_file = g_udev_device_get_device_file (dev);
+		parent = g_udev_device_get_parent (dev);
+		if (device_file == NULL || parent == NULL ||
+		    !input_device_has_switch (parent, SW_LID))
+			continue;
+		return read_lid_state (device_file);
+	}
+	return LID_STATE_UNKNOWN;
+}
+
+TabletModeSwitch *
+tablet_mode_switch_new (void)
+{
+	struct uinput_setup setup = { 0 };
+	TabletModeSwitch *tablet_switch;
+	g_autofd int fd = -1;
+
+	fd = open ("/dev/uinput", O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0) {
+		g_warning ("Could not open /dev/uinput to report tablet mode: %s",
+			   g_strerror (errno));
+		return NULL;
+	}
+
+	setup.id.bustype = BUS_VIRTUAL;
+	g_strlcpy (setup.name, SWITCH_NAME, sizeof (setup.name));
+
+	if (ioctl (fd, UI_SET_EVBIT, EV_SW) < 0 ||
+	    ioctl (fd, UI_SET_SWBIT, SW_TABLET_MODE) < 0 ||
+	    ioctl (fd, UI_DEV_SETUP, &setup) < 0 ||
+	    ioctl (fd, UI_DEV_CREATE) < 0) {
+		g_warning ("Could not create the tablet mode switch: %s",
+			   g_strerror (errno));
+		return NULL;
+	}
+
+	tablet_switch = g_new0 (TabletModeSwitch, 1);
+	tablet_switch->fd = g_steal_fd (&fd);
+	return tablet_switch;
+}
+
+void
+tablet_mode_switch_set (TabletModeSwitch *tablet_switch,
+			gboolean          tablet_mode)
+{
+	struct input_event events[2];
+
+	g_return_if_fail (tablet_switch != NULL);
+
+	memset (events, 0, sizeof (events));
+	events[0].type = EV_SW;
+	events[0].code = SW_TABLET_MODE;
+	events[0].value = tablet_mode ? 1 : 0;
+	events[1].type = EV_SYN;
+	events[1].code = SYN_REPORT;
+
+	if (write (tablet_switch->fd, events, sizeof (events)) != sizeof (events))
+		g_warning ("Could not report tablet mode: %s", g_strerror (errno));
+}
+
+void
+tablet_mode_switch_free (TabletModeSwitch *tablet_switch)
+{
+	if (tablet_switch == NULL)
+		return;
+	ioctl (tablet_switch->fd, UI_DEV_DESTROY);
+	close (tablet_switch->fd);
+	g_free (tablet_switch);
+}
