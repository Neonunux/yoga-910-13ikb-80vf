new file mode 100644
index 0000000..d13ed45
--- /dev/null
+++ b/src/hinge.h
@@ -0,0 +1,39 @@
+/*
+ * Copyright (c) 2026 Régis LELOUP <neonunux@gmail.com>
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 3 as published by
+ * the Free Software Foundation.
+ */
+
+#pragma once
+
+#include <glib.h>
+
+typedef enum {
+	HINGE_MODE_UNDEFINED = 0,
+	HINGE_MODE_LAPTOP,
+	HINGE_MODE_TABLET,
+} HingeMode;
+
+typedef enum {
+	LID_STATE_UNKNOWN = -1,
+	LID_STATE_OPEN    =  0,
+	LID_STATE_CLOSED  =  1,
+} LidState;
+
+typedef struct {
+	HingeMode mode;
+	HingeMode candidate;
+	guint     candidate_count;
+
+	/* Last reading outside the folded range, -1 if none yet */
+	gdouble   last_unfolded_angle;
+} HingeState;
+
+void        hinge_state_init      (HingeState *state);
+gboolean    hinge_state_update    (HingeState *state,
+				   gdouble     angle,
+				   LidState    lid);
+gboolean    hinge_angle_is_folded (gdouble     angle);
+const char *hinge_mode_to_string  (HingeMode   mode);
