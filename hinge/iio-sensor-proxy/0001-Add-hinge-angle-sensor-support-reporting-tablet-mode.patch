diff --git a/src/drv-iio-poll-hinge.c b/src/drv-iio-poll-hinge.c
new file mode 100644
index 0000000..55b6fb3
--- /dev/null
+++ b/src/drv-iio-poll-hinge.c
@@ -0,0 +1,161 @@
+/*
+ * Copyright (c) 2014 Bastien Nocera <hadess@hadess.net>
+ * Copyright (c) 2026 Régis LELOUP <neonunux@gmail.com>
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 3 as published by
+ * the Free Software Foundation.
+ */
+
+#include "drivers.h"
+
+#include <math.h>
+
+/* Fast enough to see a quickly folded hinge cross the tablet range */
+#define POLL_INTERVAL_MS 100
+
+/* Sensor hubs can report stale angles for a moment after being powered on */
+#define SETTLE_TIME_US (1500 * G_TIME_SPAN_MILLISECOND)
+
+typedef struct DrvData {
+	char     *input_path;
+	guint     timeout_id;
+	gint64    started;
+	gboolean  read_failed;
+
+	double    scale;
+	double    offset;
+} DrvData;
+
+static gboolean
+iio_poll_hinge_discover (GUdevDevice *device)
+{
+	return drv_check_udev_sensor_type (device, "iio-poll-hinge", "IIO poll hinge");
+}
+
+static gboolean
+hinge_changed (gpointer user_data)
+{
+	SensorDevice *sensor_device = user_data;
+	DrvData *drv_data = (DrvData *) sensor_device->priv;
+	HingeReadings readings;
+	g_autofree char *contents = NULL;
+	g_autoptr(GError) error = NULL;
+	gdouble raw;
+
+	if (!g_file_get_contents (drv_data->input_path, &contents, NULL, &error)) {
+		if (!drv_data->read_failed)
+			g_warning ("Failed to read hinge angle from %s at %s: %s",
+				   sensor_device->name, drv_data->input_path, error->message);
+		drv_data->read_failed = TRUE;
+		return G_SOURCE_CONTINUE;
+	}
+	drv_data->read_failed = FALSE;
+	if (g_get_monotonic_time () - drv_data->started < SETTLE_TIME_US)
+		return G_SOURCE_CONTINUE;
+	raw = g_ascii_strtod (contents, NULL);
+
+	/* IIO angles are in radians */
+	readings.angle = fmod ((raw + drv_data->offset) * drv_data->scale * 180.0 / G_PI, 360.0);
+	if (readings.angle < 0.0)
+		readings.angle += 360.0;
+	g_debug ("Hinge angle read from %s: %lf (scale %lf, offset %lf) = %.1lf degrees",
+		 sensor_device->name, raw, drv_data->scale, drv_data->offset, readings.angle);
+
+	sensor_device->callback_func (sensor_device, (gpointer) &readings, sensor_device->user_data);
+
+	return G_SOURCE_CONTINUE;
+}
+
+static void
+iio_poll_hinge_set_polling (SensorDevice *sensor_device,
+			    gboolean      state)
+{
+	DrvData *drv_data = (DrvData *) sensor_device->priv;
+
+	if (drv_data->timeout_id > 0 && state)
+		return;
+	if (drv_data->timeout_id == 0 && !state)
+		return;
+
+	if (drv_data->timeout_id) {
+		g_source_remove (drv_data->timeout_id);
+		drv_data->timeout_id = 0;
+	}
+
+	if (state) {
+		drv_data->started = g_get_monotonic_time ();
+		drv_data->timeout_id = g_timeout_add (POLL_INTERVAL_MS,
+						      (GSourceFunc) hinge_changed,
+						      sensor_device);
+		g_source_set_name_by_id (drv_data->timeout_id, "[iio_poll_hinge_set_polling] hinge_changed");
+
+		hinge_changed (sensor_device);
+	}
+}
+
+/* Channel attributes can be specific to the channel or shared by type */
+static gdouble
+get_channel_attr (GUdevDevice *device,
+		  const char  *attr,
+		  gdouble      default_value)
+{
+	g_autofree char *indexed = NULL;
+	g_autofree char *shared = NULL;
+
+	indexed = g_strdup_printf ("in_angl0_%s", attr);
+	if (g_udev_device_has_sysfs_attr (device, indexed))
+		return g_udev_device_get_sysfs_attr_as_double (device, indexed);
+	shared = g_strdup_printf ("in_angl_%s", attr);
+	if (g_udev_device_has_sysfs_attr (device, shared))
+		return g_udev_device_get_sysfs_attr_as_double (device, shared);
+	return default_value;
+}
+
+static SensorDevice *
+iio_poll_hinge_open (GUdevDevice *device)
+{
+	SensorDevice *sensor_device;
+	DrvData *drv_data;
+	g_autofree char *input_path = NULL;
+
+	input_path = g_build_filename (g_udev_device_get_sysfs_path (device),
+				       "in_angl0_raw", NULL);
+	if (!g_file_test (input_path, G_FILE_TEST_EXISTS))
+		return NULL;
+
+	sensor_device = g_new0 (SensorDevice, 1);
+	sensor_device->name = g_strdup (g_udev_device_get_property (device, "NAME"));
+	if (!sensor_device->name)
+		sensor_device->name = g_strdup (g_udev_device_get_name (device));
+	sensor_device->priv = g_new0 (DrvData, 1);
+	drv_data = (DrvData *) sensor_device->priv;
+
+	drv_data->scale = get_channel_attr (device, "scale", 1.0);
+	if (drv_data->scale == 0.0)
+		drv_data->scale = 1.0;
+	drv_data->offset = get_channel_attr (device, "offset", 0.0);
+	drv_data->input_path = g_steal_pointer (&input_path);
+
+	return sensor_device;
+}
+
+static void
+iio_poll_hinge_close (SensorDevice *sensor_device)
+{
+	DrvData *drv_data = (DrvData *) sensor_device->priv;
+
+	g_clear_pointer (&drv_data->input_path, g_free);
+	g_clear_pointer (&sensor_device->priv, g_free);
+	g_free (sensor_device);
+}
+
+SensorDriver iio_poll_hinge = {
+	.driver_name = "IIO Polling Hinge sensor",
+	.type = DRIVER_TYPE_HINGE,
+
+	.discover = iio_poll_hinge_discover,
+	.open = iio_poll_hinge_open,
+	.set_polling = iio_poll_hinge_set_polling,
+	.close = iio_poll_hinge_close,
+};
diff --git a/src/hinge.c b/src/hinge.c
new file mode 100644
index 0000000..f9d4020
--- /dev/null
+++ b/src/hinge.c
@@ -0,0 +1,138 @@
+/*
+ * Copyright (c) 2026 Régis LELOUP <neonunux@gmail.com>
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License version 3 as published by
+ * the Free Software Foundation.
+ */
+
+#include "hinge.h"
+
+/*
+ * Hinge angles are in degrees, from 0 with the lid closed to 360 with the
+ * screen folded against the bottom of the keyboard. In the latter position,
+ * sensors wrap around to 0: readings close to 0 mean either a closed lid or
+ * a tablet folded flat.
+ *
+ * Tent and stand postures, like tablets, leave the keyboard unusable, so
+ * all of them are reported as tablet mode.
+ */
+#define TABLET_ENTER_ANGLE	200.0
+#define TABLET_LEAVE_ANGLE	170.0
+#define FOLDED_ANGLE		 30.0
+
+/* Consecutive readings required to change mode */
+#define DEBOUNCE_READINGS	2
+
+void
+hinge_state_init (HingeState *state)
+{
+	state->mode = HINGE_MODE_UNDEFINED;
+	state->candidate = HINGE_MODE_UNDEFINED;
+	state->candidate_count = 0;
+	state->last_unfolded_angle = -1.0;
+}
+
+gboolean
+hinge_angle_is_folded (gdouble angle)
+{
+	return angle < FOLDED_ANGLE;
+}
+
+static HingeMode
+wanted_mode (const HingeState *state,
+	     gdouble           angle,
+	     LidState          lid)
+{
+	HingeMode current = state->mode;
+
+	if (hinge_angle_is_folded (angle)) {
+		/* A closed lid and a tablet folded flat look the same to the
+		 * sensors, what tells them apart is where the hinge came from:
+		 * the tablet range means it wrapped around past 360 degrees,
+		 * even if folded too fast for the tablet mode to be confirmed
+		 * already. Otherwise, keep the current mode rather than trust a
+		 * single reading, which may be off while the device moves. */
+		if (state->last_unfolded_angle >= TABLET_ENTER_ANGLE)
+			return HINGE_MODE_TABLET;
+		if (current != HINGE_MODE_UNDEFINED)
+			return current;
+
+		/* On startup, rely on the lid switch. It may report a closed lid
+		 * when folded flat on some convertibles, so it is not trusted
+		 * afterwards. */
+		switch (lid) {
+		case LID_STATE_OPEN:
+			return HINGE_MODE_TABLET;
+		case LID_STATE_CLOSED:
+			return HINGE_MODE_LAPTOP;
+		case LID_STATE_UNKNOWN:
+		default:
+			return HINGE_MODE_UNDEFINED;
+		}
+	}
+
+	if (angle >= TABLET_ENTER_ANGLE)
+		return HINGE_MODE_TABLET;
+	if (angle <= TABLET_LEAVE_ANGLE)
+		return HINGE_MODE_LAPTOP;
+
+	/* Between the thresholds, like a laptop opened flat */
+	if (current != HINGE_MODE_UNDEFINED)
+		return current;
+	return HINGE_MODE_LAPTOP;
+}
+
+/* Returns TRUE when the mode changed */
+gboolean
+hinge_state_update (HingeState *state,
+		    gdouble     angle,
+		    LidState    lid)
+{
+	HingeMode wanted;
+	gboolean folded_over;
+
+	wanted = wanted_mode (state, angle, lid);
+	folded_over = hinge_angle_is_folded (angle) &&
+		      state->last_unfolded_angle >= TABLET_ENTER_ANGLE;
+	if (!hinge_angle_is_folded (angle))
+		state->last_unfolded_angle = angle;
+
+	if (wanted == HINGE_MODE_UNDEFINED || wanted == state->mode) {
+		state->candidate_count = 0;
+		return FALSE;
+	}
+
+	/* Start with the first reading, and do not wait for more readings
+	 * once the hinge wrapped around: the tablet range was crossed */
+	if (state->mode == HINGE_MODE_UNDEFINED || folded_over) {
+		state->mode = wanted;
+		state->candidate_count = 0;
+		return TRUE;
+	}
+
+	if (state->candidate != wanted) {
+		state->candidate = wanted;
+		state->candidate_count = 0;
+	}
+	if (++state->candidate_count < DEBOUNCE_READINGS)
+		return FALSE;
+
+	state->mode = wanted;
+	state->candidate_count = 0;
+	return TRUE;
+}
+
+const char *
+hinge_mode_to_string (HingeMode mode)
+{
+	switch (mode) {
+	case HINGE_MODE_LAPTOP:
+		return "laptop";
+	case HINGE_MODE_TABLET:
+		return "tablet";
+	case HINGE_MODE_UNDEFINED:
+	default:
+		return "undefined";
+	}
+}
